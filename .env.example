# Copy to .env in the same folder (the server loads it automatically)
PORT=3000
HOST=127.0.0.1
# Optional: choose ONE AI provider. Without a key, the website still works
# using transparent template-based Socratic questions, NOT pretending to be AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# or
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# To expose on your LAN, set HOST=0.0.0.0 (use only trusted networks).
